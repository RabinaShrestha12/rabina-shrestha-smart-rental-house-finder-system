{
  "version": 2,
  "installCommand": "cd Frontend/smart-rental-frontend && npm install",
  "buildCommand": "cd Frontend/smart-rental-frontend && npm run build",
  "outputDirectory": "Frontend/smart-rental-frontend/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
